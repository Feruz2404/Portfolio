# Database
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Authentication (NextAuth v5)
# Use at least 32 random characters. Required in production.
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Public site URL used by sitemap, robots, and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin account created by `npm run seed`
# Required in production. The development fallback is documented in README only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Email (Resend)
RESEND_API_KEY=re_replace_me
FROM_EMAIL=hello@example.com

# File uploads (UploadThing)
UPLOADTHING_SECRET=sk_live_replace_me
UPLOADTHING_APP_ID=replace-me

# Dev only: comma-separated list of extra allowed origins for Next.js HMR
# ALLOWED_DEV_ORIGINS=192.168.1.100
