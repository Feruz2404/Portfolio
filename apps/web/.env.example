# ─── Database (required for content, admin, contact leads) ───────────────────
# The app degrades gracefully without this (empty states), but nothing is
# persisted and DB-backed pages stay empty. Use a PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# ─── Authentication (NextAuth v5) ───────────────────────────────────────────
# NEXTAUTH_SECRET must be at least 32 characters. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=your-very-long-random-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# ─── Site URL (used in canonical URLs, hreflang, sitemap, emails) ────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosting only (e.g. `next start` behind a proxy): NextAuth v5 requires the
# host to be trusted. Vercel sets this automatically; set it yourself otherwise.
# AUTH_TRUST_HOST=true

# ─── Email (Resend) — optional ───────────────────────────────────────────────
# When both are set, contact-form submissions also send a notification email.
# Leads are always saved to the DB regardless; a missing key never fakes success.
RESEND_API_KEY=re_...
FROM_EMAIL=hello@yourdomain.com

# ─── File uploads (UploadThing) — optional (admin media) ─────────────────────
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=your-app-id

# ─── Seeding (optional) ──────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@feruz.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
# Set to true to insert clearly-labelled DEMO content for local dev ONLY.
# SEED_DEMO=true

# ─── Dev only (optional) ─────────────────────────────────────────────────────
# Comma-separated list of extra allowed origins for Next.js HMR.
# ALLOWED_DEV_ORIGINS=192.168.1.100
