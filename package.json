{
  "name": "enterprise-portfolio",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "autoprefixer": "^10.4.20"
  },
  "overrides": {
    "effect": "3.22.0",
    "postcss": "8.5.21"
  },
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "lint": "npm --workspace apps/web run lint",
    "typecheck": "npm --workspace apps/web run typecheck",
    "format": "npm --workspace apps/web run format",
    "prisma:generate": "npm --workspace apps/web run prisma:generate",
    "prisma:migrate": "npm --workspace apps/web run prisma:migrate",
    "prisma:studio": "npm --workspace apps/web run prisma:studio",
    "seed": "npm --workspace apps/web run seed"
  }
}
